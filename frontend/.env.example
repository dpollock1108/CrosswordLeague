# Local development only.
#
# The dev server runs on :5173 and the API on :8001, so the frontend needs an
# absolute API URL to cross that port boundary. In production both are the same
# Cloud Run service and VITE_API_BASE is built empty, which makes every request
# same-origin — do not set it to a real URL there.
VITE_API_BASE=http://localhost:8001

# Google Sign-In client ID. Vite inlines this at BUILD time, so the production
# image gets it from a --build-arg, not from a runtime env var. It is public by
# design — it ships in the page to every visitor.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
